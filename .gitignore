*.out
coverage.*
*.coverprofile
profile.cov

# Project build artifacts
/build/

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

